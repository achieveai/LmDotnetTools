<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- RETIRED (2026-10-15): the CodeReviewDaemon host is disabled until Reviewd.Sample is
         self-sufficient. It is NOT runnable as a daemon — Program.cs (the entry point) is excluded
         from compilation below and the output is a plain library. Reviewd.Sample still consumes its
         Agents/Auth/Configuration/Orchestration/Persistence/Workspace/Diagnostics/Eval types as a
         library dependency, so this project still builds; it just cannot be launched.
         To re-enable the daemon: restore <OutputType>Exe</OutputType>, remove the Program.cs
         <Compile Remove> below, and re-add tests/CodeReviewDaemon.Sample.Tests to the solution. -->
    <OutputType>Library</OutputType>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- RETIRED: the daemon entry point is excluded so this project cannot be launched. Program.cs
         holds the top-level statements + `public partial class Program`; without it the output is a
         non-runnable library. Restore this (and <OutputType>Exe</OutputType>) to re-enable the daemon. -->
    <Compile Remove="Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- SQLite is the daemon's orchestration source of truth (review_run / poll_cursor /
         review_outbox / review_artifact). Pinned to the version already used across
         LmMultiTurn / Misc. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.5" />
    <!-- Optional structured JSONL logging for the daemon's own logs (CodeReviewDaemon:LogFilePath) —
         Serilog CompactJsonFormatter, DuckDB-queryable. Same versions LmTestUtils pins for test logging. -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <!-- ReviewActionsParser (Orchestration/ReviewActions.cs) deserializes the synthesis turn's
         `review-actions` fence directly, so it declares this explicitly rather than relying on the
         transitive reference LmSampleShared already brings in. Pinned to the version used everywhere
         else in the repo (src/LmCore, samples/LmSampleShared, samples/LmStreaming.Sample). -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- All reusable agent/sandbox/OAuth/webhook machinery lives in LmAgentInfra (shared with
         LmStreaming.Sample); LmCore + LmMultiTurn flow transitively. -->
    <ProjectReference Include="..\..\src\LmAgentInfra\AchieveAi.LmDotnetTools.LmAgentInfra.csproj" />
    <ProjectReference Include="..\LmSampleShared\LmSampleShared.csproj" />
    <!-- CopilotModelCatalogLogger uses the Copilot credential + catalog parsing types for diagnostic model
         discovery at daemon startup. No MultiTurnAgent dependency — only auth + model wrappers. -->
    <ProjectReference Include="..\..\src\GithubCopilotProvider\AchieveAi.LmDotnetTools.GithubCopilotProvider.csproj" />
    <!-- JudgeAgent scores through the shared eval harness (P6 §4.2) rather than owning a second
         private copy of verdict parsing. LmEval is a leaf over LmCore + LmMultiTurn. -->
    <ProjectReference Include="..\..\src\LmEval\AchieveAi.LmDotnetTools.LmEval.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The route-exposure test (AC#4) boots this host via WebApplicationFactory<Program> and
         inspects internal wiring, so the generated top-level Program and any internal types must be
         visible to the test assembly. -->
    <InternalsVisibleTo Include="CodeReviewDaemon.Sample.Tests" />
    <InternalsVisibleTo Include="Reviewd.Sample" />
  </ItemGroup>
  <ItemGroup>
    <!-- The Web SDK does not auto-glob EmbeddedResource items, so the daemon's YAML/Scriban prompt
         template (DaemonAgentFactory) must be included explicitly, with a stable LogicalName. -->
    <EmbeddedResource Include="Prompts\daemon-prompts.yaml" LogicalName="CodeReviewDaemon.Sample.Prompts.daemon-prompts.yaml" />
  </ItemGroup>
</Project>
