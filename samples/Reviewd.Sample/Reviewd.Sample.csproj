<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="ReviewRunnerSandbox.py" />
    <EmbeddedResource Include="MergeSandbox.py" />
    <EmbeddedResource Include="JudgeSandbox.py" />
    <EmbeddedResource Include="Prompts/merged-judge.md" LogicalName="Reviewd.Sample.Prompts.merged-judge.md" />
    <InternalsVisibleTo Include="CodeReviewDaemon.Sample.Tests" />
    <ProjectReference Include="../CodeReviewDaemon.Sample/CodeReviewDaemon.Sample.csproj" />
    <ProjectReference Include="../../src/Misc/AchieveAi.LmDotnetTools.Misc.csproj" />
    <ProjectReference Include="../../src/Sandbox/AchieveAi.LmDotnetTools.Sandbox.csproj" />
  </ItemGroup>
</Project>
