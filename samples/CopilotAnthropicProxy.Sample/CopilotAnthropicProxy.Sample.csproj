<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- public partial Program (required by WebApplicationFactory<Program>) emits CS1591 under
         GenerateDocumentationFile + TreatWarningsAsErrors; suppress doc-comment warnings for the sample. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Copilot transport and authentication live in GithubCopilotProvider. Web-tool contracts,
         validation, output hygiene, and the Jina integration live in Misc. -->
    <ProjectReference Include="..\..\src\GithubCopilotProvider\AchieveAi.LmDotnetTools.GithubCopilotProvider.csproj" />
    <ProjectReference Include="..\..\src\Misc\AchieveAi.LmDotnetTools.Misc.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="CopilotAnthropicProxy.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Structured JSONL logging (Serilog + CompactJsonFormatter), matching LmStreaming.Sample
         and the shared test logging stack so proxy logs are DuckDB-queryable in the same format. -->
    <PackageReference Include="Serilog.AspNetCore" Version="9.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Ship the Claude Code launch helper with the proxy so a published drop is
         self-contained. The Web SDK already globs **\*.json into Content, so the
         MCP config must be Update-d (Include would be a duplicate item). -->
    <Content Include="setupClaude.ps1" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="claude-web-mcp.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
