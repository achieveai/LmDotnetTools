# LmStreaming.Sample Environment Configuration
# Copy this file to .env and fill in your values.
# .env files are git-ignored and will not be committed.
#
# Where .env is loaded from (Program.FindEnvFile):
#   1. $env:LMSTREAMING_ENV_FILE, if it is set AND the file exists. publish-launch.ps1 sets this
#      when it launches the published artifact, so the running instance uses the .env beside the
#      project rather than one that happens to sit above the publish directory. If the variable is
#      set but the path does not exist, the override is IGNORED (never trusted blindly) and a
#      warning is written to stderr before falling through to the walk-up below.
#   2. Otherwise the first .env — or, failing that, .env.test — found walking up from the
#      application's base directory.
#
# A DEPLOYED instance (publish-launch.ps1 -DestinationDirectory) keeps its .env in the deployment
# directory: the deploy preserves it byte-for-byte across upgrades and never takes one from the
# build output. A FIRST deploy to a new destination has no .env at all and the script warns about
# it — create one there after that first deploy; every later deploy will carry it forward.

# Provider mode: "test" (default), "openai", "anthropic", or "codex"
LM_PROVIDER_MODE=test

# OpenAI / OpenAI-compatible provider settings
# Used when LM_PROVIDER_MODE=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# Anthropic / Anthropic-compatible provider settings
# Used when LM_PROVIDER_MODE=anthropic
# NOTE: ANTHROPIC_BASE_URL here is consumed by the IN-HOUSE AnthropicClient,
# which appends /messages directly — so the configured value MUST include the
# /v1 segment.
#   In-house client (this var):           https://api.anthropic.com/v1
#   Anthropic SDK / Claude Agent SDK CLI: https://api.anthropic.com  (NO /v1!)
# The official Anthropic SDK appends /v1/messages itself; passing a /v1-suffixed
# URL there produces /v1/v1/messages and 404s silently (issue #29). The sample
# normalizes this automatically via BaseUrlNormalizer when wiring claude-mock.
# For Kimi: https://api.kimi.com/coding
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Example: Kimi 2.5 via OpenAI-compatible API
# LM_PROVIDER_MODE=openai
# OPENAI_API_KEY=your-kimi-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=kimi-2.5

# Example: Kimi 2.5 via Anthropic-compatible API
# LM_PROVIDER_MODE=anthropic
# ANTHROPIC_API_KEY=your-kimi-key
# ANTHROPIC_BASE_URL=https://api.kimi.com/coding
# ANTHROPIC_MODEL=kimi-2.5

# Anthropic-compatible provider families — generic, dropdown-visible providers discovered from
# env vars at startup (no code change needed to add a model or a whole new vendor). Unlike
# LM_PROVIDER_MODE=anthropic above (one fixed provider), each family here contributes one dropdown
# entry PER model listed in its _MODELS var. ANTHROPIC_COMPAT_PROVIDERS is a comma-separated list
# of family keys; each key <KEY> then needs its own <KEY>_ANTHROPIC_URL / <KEY>_APIKEY / <KEY>_MODELS.
# Example: DeepSeek's Anthropic-compatible API (https://api-docs.deepseek.com/guides/anthropic_api).
# ANTHROPIC_COMPAT_PROVIDERS=DEEPSEEK
# DEEPSEEK_ANTHROPIC_URL=https://api.deepseek.com/anthropic
# DEEPSEEK_APIKEY=
# DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash

# OpenAI Codex App Server settings
# Used when LM_PROVIDER_MODE=codex
CODEX_CLI_PATH=codex
CODEX_CLI_MIN_VERSION=0.101.0
CODEX_APP_SERVER_STARTUP_TIMEOUT_MS=30000
CODEX_TURN_COMPLETION_TIMEOUT_MS=120000
CODEX_TURN_INTERRUPT_GRACE_PERIOD_MS=5000
CODEX_MODEL=gpt-5.3-codex
CODEX_API_KEY=
CODEX_BASE_URL=
CODEX_APPROVAL_POLICY=on-request
CODEX_SANDBOX_MODE=workspace-write
CODEX_SKIP_GIT_REPO_CHECK=true
CODEX_NETWORK_ACCESS_ENABLED=true
CODEX_WEB_SEARCH_MODE=disabled
CODEX_BASE_INSTRUCTIONS=
CODEX_DEVELOPER_INSTRUCTIONS=
CODEX_MODEL_INSTRUCTIONS_FILE=
CODEX_MODEL_INSTRUCTIONS_THRESHOLD_CHARS=8000
CODEX_TOOL_BRIDGE_MODE=hybrid
CODEX_EXPOSE_INTERNAL_TOOLS_AS_TOOL_MESSAGES=true
CODEX_EMIT_LEGACY_INTERNAL_TOOL_REASONING_SUMMARIES=false
CODEX_RPC_TRACE_ENABLED=false
CODEX_RPC_TRACE_FILE=
# Diagnostic-only toggle. Raw provider streaming is the default path.
CODEX_EMIT_SYNTHETIC_MESSAGE_UPDATES=false
CODEX_SYNTHETIC_MESSAGE_UPDATE_CHUNK_CHARS=28
CODEX_MCP_PORT=39200
