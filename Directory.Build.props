<Project>
  <PropertyGroup>
    <!-- Common NuGet Package Properties -->
    <Company>Achieve.AI</Company>
    <Authors>Achieve.AI</Authors>
    <Copyright>Copyright © Achieve.AI 2025</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/achieveai/LmDotnetTools</PackageProjectUrl>
    <RepositoryUrl>https://github.com/achieveai/LmDotnetTools</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See CHANGELOG.md for detailed release notes.</PackageReleaseNotes>
    <!-- Centralized Versioning - UPDATE ONLY THIS SECTION FOR NEW RELEASES -->
    <MajorVersion>1</MajorVersion>
    <MinorVersion>0</MinorVersion>
    <PatchVersion>33</PatchVersion>
    <PreReleaseLabel></PreReleaseLabel>
    <!-- Use values like 'alpha', 'beta', 'rc.1' or leave empty for stable -->
    <!-- Computed Version Properties (DO NOT MODIFY) -->
    <Version Condition="'$(PreReleaseLabel)' == ''"
      >$(MajorVersion).$(MinorVersion).$(PatchVersion)</Version
    >
    <Version Condition="'$(PreReleaseLabel)' != ''"
      >$(MajorVersion).$(MinorVersion).$(PatchVersion)-$(PreReleaseLabel)</Version
    >
    <AssemblyVersion>$(MajorVersion).$(MinorVersion).0.0</AssemblyVersion>
    <FileVersion>$(MajorVersion).$(MinorVersion).$(PatchVersion).0</FileVersion>
    <PackageVersion>$(Version)</PackageVersion>
    <!-- Package Generation -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Suppress warnings that don't align with project conventions -->
    <NoWarn>$(NoWarn);IDE0130;IDE0330</NoWarn>
    <!-- IDE0130: Namespace does not match folder structure (intentional naming convention) -->
    <!-- IDE0330: Prefer readonly span (uses .NET 9 Lock type, incompatible with .NET 8) -->
    <!-- Enforce zero-warning builds repo-wide. Local opt-out via -p:TreatWarningsAsErrors=false. -->
    <TreatWarningsAsErrors Condition="'$(TreatWarningsAsErrors)' == ''">true</TreatWarningsAsErrors>
    <!-- Common Tags -->
    <PackageTags>dotnet;ai;llm;language-model;achieve-ai</PackageTags>
  </PropertyGroup>

  <!-- Payload diet: trim build-output files that are never consumed at runtime here. -->
  <PropertyGroup>
    <!-- Only build/copy the English satellite resource assemblies for referenced tooling
         (e.g. VSTest, xunit runners). Without this, MSBuild copies one localized
         *.resources.dll per referenced package per culture it ships (cs/de/es/fr/it/ja/ko/pl/
         pt-BR/ru/tr/zh-Hans/zh-Hant), none of which this repo's tests or samples localize into
         or read. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Drop only .xml from the files that ride along when a referenced assembly is copied to a
         project's output. SDK default (Microsoft.Common.CurrentVersion.targets) is
         ".pdb;.xml;.pri;.dll.config;.exe.config" - this keeps everything except .xml, which is
         each dependency's XML doc comment file. Nothing in this repo reads XML docs at runtime
         (no Swagger/Swashbuckle XML-doc ingestion, no reflection-based doc readers) - confirmed
         by repo-wide search - so that copy is pure waste. .pri/.dll.config/.exe.config are kept
         at their default: no measured savings and each has a real consumer (WinRT/UWP resource
         index files, app/exe .config redirects) that this property would otherwise silently
         break for a future project that needs one. This does not affect
         GenerateDocumentationFile: each project still produces its own .xml doc file in its own
         bin output; it just stops that file from being copied into every downstream
         project/test/sample that references it. -->
    <AllowedReferenceRelatedFileExtensions>.pdb;.pri;.dll.config;.exe.config</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
  
  <!-- Build and Test Logging Configuration -->
  <PropertyGroup>
    <!-- Log output directory (git-ignored) -->
    <LogOutputDir>$(MSBuildThisFileDirectory).logs</LogOutputDir>
    
    <!-- MSBuild binary log for builds (use: dotnet build -bl) -->
    <!-- Binary logs can be viewed with https://msbuildlog.com/ -->
    <MSBuildBinaryLogPath>$(LogOutputDir)/build-$(MSBuildProjectName).binlog</MSBuildBinaryLogPath>
  </PropertyGroup>
  
  <!-- Test logging defaults (applied when running dotnet test) -->
  <PropertyGroup Condition="'$(IsTestProject)' == 'true' OR $(MSBuildProjectName.EndsWith('.Tests'))">
    <!-- TRX format for structured test results -->
    <VSTestResultsDirectory>$(LogOutputDir)/test-results</VSTestResultsDirectory>
  </PropertyGroup>
  <!-- Include documentation files in packages -->
  <ItemGroup>
    <!-- Main README -->
    <None
      Include="$(MSBuildThisFileDirectory)README.md"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)README.md')"
    />
    <!-- CHANGELOG -->
    <None
      Include="$(MSBuildThisFileDirectory)CHANGELOG.md"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)CHANGELOG.md')"
    />
    <!-- LICENSE -->
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)LICENSE')"
    />
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE.md"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)LICENSE.md')"
    />
    <None
      Include="$(MSBuildThisFileDirectory)LICENSE.txt"
      Pack="true"
      PackagePath="\"
      Condition="Exists('$(MSBuildThisFileDirectory)LICENSE.txt')"
    />
    <!-- Component-specific documentation -->
    <None
      Include="$(MSBuildProjectDirectory)\README.md"
      Pack="true"
      PackagePath="docs\"
      Condition="Exists('$(MSBuildProjectDirectory)\README.md')"
    />
  </ItemGroup>
</Project>
