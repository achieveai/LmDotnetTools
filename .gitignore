# Husky.Net auto-install scratch dir
.husky/_/

# OAuth refresh/access token store (FileOAuthTokenStore) — never commit secrets
**/oauth-tokens/

# Scratchpad working directory (keep folder, ignore contents)
scratchPad/*
!scratchPad/.gitkeep

# Git worktrees (isolated workspaces — never track their contents)
worktrees/
.worktrees/

# Local proxy rebuild/build scratch dir (multi-GB; never track)
/.run/

# Local scratch dir under the sample (publish-launch.ps1 no longer writes instance-<port>.json here;
# its run-state side-car is .run-state.json inside the publish run directory ignored just below).
samples/LmStreaming.Sample/.run/

# publish-launch.ps1 standalone-publish run directories (retained, inspectable artifacts — never tracked)
/.claude/scratchpad/lmstreaming-standalone-publish/

# publish-daemon.ps1 staging run directories. Same contract as the sibling above: the script
# retains each run for inspection instead of deleting it, so a full publish output accumulates
# here. The entry above existed and this one did not, which is the whole defect.
/.claude/scratchpad/codereviewdaemon-publish/

# publish-launch.ps1 -DestinationDirectory deploy siblings. These exist only transiently during a
# swap, but a deploy interrupted between its two renames leaves them behind — and a backup sibling
# is a COMPLETE copy of a deployment, including .env, oauth-tokens/ and conversations/. If a
# destination is ever placed inside this repository, those must never be committable. Anchored
# nowhere, so they match at any depth.
*.candidate-*/
*.backup-*/

# Ad-hoc debug screenshots dropped at the repo root (doc screenshots under docs/ stay tracked)
/*.png
