<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTestProject>false</IsTestProject>
    <RootNamespace>AchieveAi.LmDotnetTools.LmTestUtils</RootNamespace>
    <AssemblyName>AchieveAi.LmDotnetTools.LmTestUtils.Xunit</AssemblyName>
    <PackageId>AchieveAi.LmDotnetTools.LmTestUtils.Xunit</PackageId>
    <Description>xUnit-coupled test helpers for LmDotnetTools: LoggingTestBase, the Serilog structured test-logging configuration and its module initializer, and WindowsOnlyFact. Split out of LmTestUtils so that referencing the mock/HTTP helpers does not drag xunit and the xUnit Serilog sink into an application's closure.</Description>
    <PackageTags>$(PackageTags);testing;xunit;logging;serilog</PackageTags>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.5" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="9.0.5" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- Serilog structured test logging. These live here, not in LmTestUtils, because the
         xUnit sink and the ITestOutputHelper surface are only reachable from these types. -->
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.XUnit" Version="3.0.5" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Enrichers.Thread" Version="4.0.0" />
    <PackageReference Include="Serilog.Enrichers.Environment" Version="3.0.1" />
  </ItemGroup>
</Project>
