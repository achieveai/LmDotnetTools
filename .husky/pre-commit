#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

# Verify formatting matches the repository's canonical CSharpier output before allowing the
# commit. CSharpier is pinned in .config/dotnet-tools.json and configured by .csharpierrc, so
# the hook, the editor and CI all format identically. The full warning gate
# (TreatWarningsAsErrors) runs at build time and in CI; pre-commit stays fast by checking only
# the staged .cs files, while CI checks the whole tree.
exec dotnet husky run --name format-verify
