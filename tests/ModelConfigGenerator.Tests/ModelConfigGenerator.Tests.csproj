<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- net9.0 matches 29 of the 33 test projects here, and is the only target that actually RUNS: this
         box carries runtimes 9/10/11 and no net8, so a net8 leg aborts with "You must install or update
         .NET" before a single test executes. Multi-targeting net8.0;net9.0 would look more conservative
         and be strictly worse — see LmLifecycle.Tests, Sandbox.Tests and Sandbox.Integration.Tests, whose
         net8 legs silently never run while the summary line still reads "Passed!".
         Referencing the net8.0 ModelConfigGenerator tool from here is fine; net9.0 consumes net8.0
         assemblies. If that tool is ever multi-targeted, this can follow, but it does not need to. -->
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>AchieveAi.LmDotnetTools.ModelConfigGenerator.Tests</AssemblyName>
    <RootNamespace>AchieveAi.LmDotnetTools.ModelConfigGenerator.Tests</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.6.0" />
    <PackageReference Include="xunit" Version="2.4.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="coverlet.collector" Version="6.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Moq" Version="4.20.69" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Tools\ModelConfigGenerator\ModelConfigGenerator.csproj" />
    <ProjectReference Include="..\..\src\LmConfig\AchieveAi.LmDotnetTools.LmConfig.csproj" />
  </ItemGroup>
</Project>