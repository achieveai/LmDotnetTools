// Round h1: the shipped defaults. No prompt file and no flag: map_read is on by default and the two-pass
// guidance is in the built-in planner prompt (what m4 measured on tr1). Held-out on bc2 and sw1 to confirm
// the change is neutral where Opus greps. Opus-alone control stays at medium: the knob under test is L2.
// Run: --models opuna --variants ship --tasks bc2,sw1 --seeds 3
{
  "evalDir": "evals/dual-layer-eval",
  "modeName": "dual-layer-eval",
  "modeFile": "mode.json",
  "workspaceName": "dual-layer-eval",
  "workspacesRoot": "B:/sandbox-workspaces/workspaces/lmstreaming-sample-7f7fa61a839e7f56",
  "models": [
    "claude-opus-5.5",
    "gpt-6-luna",
    "opuna"
  ],
  "variants": [
    {
      "name": "ship",
      "extraArgs": [],
      "reasoningEffort": "medium"
    }
  ],
  "tasks": [
    "bc2",
    "sw1"
  ],
  "seeds": 3,
  "maxParallelRuns": 3,
  "perRunTimeoutMinutes": 50,
  "host": {
    "sandbox": true,
    "extraArgs": [
      "--SandboxGateway:BaseUrl=http://127.0.0.1:3000",
      "--SandboxGateway:AutoSpawn=true",
      "--SandboxGateway:WorkspaceBasePath=B:/sandbox-workspaces/workspaces",
      "--SandboxGateway:Marketplaces=demo",
      "--ClientTools:AskUserQuestion=false"
    ],
    "shutdownGraceSeconds": 15,
    "readinessTimeoutSeconds": 180
  }
}
