// TodoEval.Runner config for the compaction strategy eval.
//
//   dotnet run --project samples/TodoEval.Runner -- \
//     --config evals/compaction-eval/runner.example.jsonc --env-file <path to .env>
//
// Copy this file before editing: the gateway paths below are placeholders and the env file carries
// provider credentials, so neither belongs in a committed config.
//
// One host process is launched PER VARIANT, because every compaction knob binds onto a DI singleton
// resolved at the host's boot — that is the whole reason the variant axis exists. Every
// (task x model x seed) cell then runs against that host before the next variant starts.
{
  "evalDir": "evals/compaction-eval",
  "modeName": "compaction-eval", // must equal the "name" in evals/compaction-eval/mode.json
  "workspaceName": "compaction-eval",

  "models": ["gpt-5.6-terra"],

  // The strategies under test. Both run the identical corpus; the only difference is the option-set
  // handed to their host, which is what makes the cost and outcome deltas attributable.
  "variants": [
    {
      // The control arm. Compaction off entirely: no recall tool, no checkpoint, request built as
      // before. Its cost is the baseline every other variant is judged against.
      "name": "off",
      "extraArgs": ["--Compaction:Mode=Off"]
    },
    {
      // Checkpoints built, appended and activated; the execution view hides the compacted rows.
      "name": "compact-v0",
      "extraArgs": ["--Compaction:Mode=Compact"]
      // Add further knobs here to make this a distinct arm, e.g.
      //   "--Compaction:TargetRatio=0.35", "--Compaction:SummaryModelId=<model>"
      // The sweep manifest records these verbatim, and --compare REFUSES to compare two sweeps whose
      // variant definitions differ — so changing a knob here retires the old baseline on purpose.
    }
  ],

  // Task ids under evals/compaction-eval/tasks/. Each needs a task.md; expected-board.json is
  // optional and its absence means the run has NO board gate, reported as not measurable rather
  // than failed. The full suite is c1, c2, d1, m1, r1, s1 — start with two while calibrating.
  "tasks": ["c1", "d1"],

  "seeds": 2,
  "maxParallelRuns": 2, // concurrent conversations against ONE variant's host
  "perRunTimeoutMinutes": 30,

  "host": {
    // A coding eval needs real file and shell tools, so the host stands up its sandbox gateway
    // instead of the todo-eval's --SandboxGateway:AutoSpawn=false pin.
    "sandbox": true,
    "extraArgs": [
      "--SandboxGateway:AutoSpawn=true",
      // REPLACE both with the paths to your built gateway binaries.
      "--SandboxGateway:GatewayExePath=B:/sources/SandboxedOstoolsMcpServer/target/release/mcp-gateway.exe",
      "--SandboxGateway:AgentCliPath=B:/sources/SandboxedOstoolsMcpServer/target/release/agent-cli.exe"
      // Egress is DEFAULT-DENY and every rule widens it. The shipped appsettings enables one
      // docs-host rule; disable it for a hermetic run:
      //   "--SandboxGateway:Network:Rules:public-docs:Enabled=false"
    ],

    // Publishing LmStreaming.Sample once per variant is the dominant startup cost. Point this at a
    // pre-published output to pay it once; the runner still copies it into a fresh instance dir per
    // host and excludes the source's own runtime state, so the isolation is unchanged.
    // "publishDir": "B:/published/LmStreaming.Sample",

    "shutdownGraceSeconds": 15, // debounced board/usage persistence must flush before the kill
    "readinessTimeoutSeconds": 180 // a gateway-spawning host takes longer to answer than a bare one
  }
}
