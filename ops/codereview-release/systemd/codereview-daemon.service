[Unit]
Description=Verified CodeReview daemon
After=codereview-host.service
Requires=codereview-host.service
# See codereview-host.service: PartOf makes the pair target a real stop/start handle so
# release.py can take 127.0.0.1:5081 deliberately instead of racing this unit for it.
PartOf=codereview-pair.target

[Service]
Type=simple
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=DOTNET_ENVIRONMENT=Production
Environment=CODEREVIEW_DEVELOPMENT_IDENTITY=
Environment=ASPNETCORE_URLS=http://127.0.0.1:5081
Environment=CodeReviewDaemon__ControlSocketPath=%h/.local/share/codereview/daemon-control.sock
ExecStart=/bin/sh -c 'r=$$(cat %h/.local/share/codereview/pointers/active); exec %h/.local/share/codereview/releases/$$r/daemon/CodeReviewDaemon.Sample --review achieveai'
Restart=on-failure
RestartSec=10
NoNewPrivileges=true

[Install]
WantedBy=codereview-pair.target
